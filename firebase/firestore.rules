rules_version = '2';

// Multi-tenant POS Suite rules.
// - Every business is a tenant: tenants/{tenantId}/... ; only its members can read it.
// - A member's role (owner, admin, manager, accountant, storekeeper, viewer, terminal) decides writes.
// - Licensed modules (tenants/{id}.modules) gate writes to ERP / finance / CRM collections.
// - Closed checks and issued invoices are immutable (tax records).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function tenantPath(t) { return /databases/$(database)/documents/tenants/$(t); }
    function memberPath(t) { return /databases/$(database)/documents/tenants/$(t)/members/$(request.auth.uid); }
    // One document lookup per check: rules may make at most 10 (20 per batch) lookups.
    function isMember(t) { return signedIn() && exists(memberPath(t)); }
    function hasRole(t, roles) { return signedIn() && get(memberPath(t)).data.role in roles; }
    function isAdmin(t) { return hasRole(t, ['owner', 'admin']); }
    function isManager(t) { return hasRole(t, ['owner', 'admin', 'manager']); }
    function canPos(t) { return hasRole(t, ['owner', 'admin', 'manager', 'terminal']); }
    function canStock(t) { return hasRole(t, ['owner', 'admin', 'manager', 'storekeeper']); }
    function canBooks(t) { return hasRole(t, ['owner', 'admin', 'accountant']); }
    function canSeeBooks(t) { return hasRole(t, ['owner', 'admin', 'accountant', 'auditor', 'manager']); }
    function canAudit(t) { return hasRole(t, ['owner', 'admin', 'auditor']); }
    function sameApproval() {
      let a = request.resource.data.get('ledger', {});
      let b = resource.data.get('ledger', {});
      return a.get('journalApprovalThreshold', -1) == b.get('journalApprovalThreshold', -1)
          && a.get('paymentApprovalThreshold', -1) == b.get('paymentApprovalThreshold', -1)
          && a.get('matchTolerance', {}) == b.get('matchTolerance', {});
    }
    function moduleOn(t, m) { return get(tenantPath(t)).data.modules.get(m, false) == true; }
    function isPlatformAdmin() { return signedIn() && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)); }
    function idMatches(id) { return !('id' in request.resource.data) || request.resource.data.id == id; }
    // updatedBy/updatedAt are the audit stamp every client write carries.
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys.concat(['updatedBy', 'updatedAt'])); }

    // Platform administrators (the software vendor) are listed here by hand in the console.
    match /platformAdmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Who may create businesses in this project. The first person to set up a business claims the
    // deployment (the installer or the client's owner); after that only they, the people they list
    // in `creators`, owners/administrators of an existing business, or platform admins can.
    // Set openSignup to true only on your own demo/SaaS project.
    function deploymentPath() { return /databases/$(database)/documents/deployment/config; }
    function mayCreateBusiness() {
      return isPlatformAdmin()
        || (!exists(deploymentPath()) && getAfter(deploymentPath()).data.ownerUid == request.auth.uid)
        || (exists(deploymentPath()) && (get(deploymentPath()).data.get('openSignup', false) == true
                                         || get(deploymentPath()).data.ownerUid == request.auth.uid
                                         || request.auth.uid in get(deploymentPath()).data.get('creators', [])))
        || (request.resource.data.get('createdFromTenant', '') != '' && hasRole(request.resource.data.createdFromTenant, ['owner', 'admin']));
    }
    match /deployment/{docId} {
      allow read: if signedIn();
      allow create: if docId == 'config' && signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.get('openSignup', false) == false;
      allow update: if docId == 'config' && signedIn() && (resource.data.ownerUid == request.auth.uid || isPlatformAdmin())
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    // One-time codes that connect phones and tablets: only the deviceApi function reads or writes them.
    match /devicePairings/{codeHash} {
      allow read, write: if false;
    }

    // Invitations are keyed by lower-case email; the invited person can read and accept theirs.
    match /invites/{email} {
      allow read: if signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email;
      allow create, update: if isAdmin(request.resource.data.tenantId) && request.resource.data.role != 'owner';
      allow delete: if (signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email) || isAdmin(resource.data.tenantId);
    }

    // Audit trail: written only by Cloud Functions, outside tenants/… so it cannot re-trigger itself.
    match /auditLog/{t}/{part}/{id} {
      allow read: if canAudit(t);
      allow write: if false;
    }

    // Lets a signed-in user find the tenants they belong to (collection-group query on members.uid).
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Licence fields (edition, entitlement, activated licence) are written only by the licence
    // function after it verifies the vendor's signature. Administrators switch modules on and off,
    // but only modules inside the entitlement.
    function licenceUnchanged() { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'entitlements', 'licence', 'trialEndsAt', 'ownerUid', 'createdAt']); }
    function modulesWithinEntitlement() {
      return resource.data.get('plan', '') == 'demo' || !('entitlements' in resource.data)
          || request.resource.data.get('modules', {}).diff(resource.data.get('modules', {})).affectedKeys().hasOnly(resource.data.entitlements.modules);
    }

    match /tenants/{t} {
      allow read: if isMember(t) || isPlatformAdmin();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.id == t
                    && request.resource.data.plan in ['trial', 'demo'] && !('licence' in request.resource.data)
                    && mayCreateBusiness();
      allow update: if (isAdmin(t) && licenceUnchanged() && modulesWithinEntitlement()) || isPlatformAdmin();
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(t);
        // Owner joining their new tenant (same batch as the tenant), an accepted invite, or an admin.
        allow create: if signedIn() && uid == request.auth.uid && request.resource.data.uid == uid && request.resource.data.tenantId == t && (
                          (request.resource.data.role == 'owner' && getAfter(tenantPath(t)).data.ownerUid == request.auth.uid)
                       || (request.auth.token.email != null && request.auth.token.email_verified == true
                           && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()))
                           && get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.tenantId == t
                           && get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.role == request.resource.data.role)
                       )
                       || (isAdmin(t) && request.resource.data.role != 'owner');
        // A connected phone or tablet stays a POS terminal: it can be renamed, never promoted.
        allow update: if isAdmin(t) && resource.data.role != 'owner' && request.resource.data.role != 'owner' && onlyChanges(['role', 'name', 'staffId'])
                      && (!('device' in resource.data) || request.resource.data.role == 'terminal');
        allow delete: if isAdmin(t) && resource.data.role != 'owner';
      }

      // ── Configuration (back office) ──
      // Approval thresholds are a control: only an owner/administrator may change them.
      match /settings/{id} {
        allow read: if isMember(t);
        allow write: if idMatches(id) && (
             (id != 'accounting' && isManager(t))
          || (id == 'accounting' && (isAdmin(t) || (canBooks(t) && resource != null && sameApproval()))));
      }
      match /properties/{id} { allow read: if isMember(t); allow write: if isAdmin(t) && idMatches(id); }
      match /revenueCenters/{id} { allow read: if isMember(t); allow write: if isAdmin(t) && idMatches(id); }
      match /workstations/{id} { allow read: if isMember(t); allow write: if isAdmin(t) && idMatches(id); }
      match /printers/{id} { allow read: if isMember(t); allow write: if isManager(t) && idMatches(id); }
      match /tables/{id} { allow read: if isMember(t); allow write: if isManager(t) && idMatches(id); }
      match /orderTypes/{id} { allow read: if isMember(t); allow write: if isManager(t) && idMatches(id); }
      match /menuCategories/{id} { allow read: if isMember(t); allow write: if isManager(t) && idMatches(id); }
      match /modifierGroups/{id} { allow read: if isMember(t); allow write: if isManager(t) && idMatches(id); }
      match /discounts/{id} { allow read: if isMember(t); allow write: if isManager(t) && idMatches(id); }
      match /reasonCodes/{id} { allow read: if isMember(t); allow write: if isManager(t) && idMatches(id); }
      match /tenderMedia/{id} { allow read: if isMember(t); allow write: if isManager(t) && idMatches(id); }
      match /roles/{id} { allow read: if isMember(t); allow write: if isAdmin(t) && idMatches(id); }
      // PIN hashes and card numbers never go on staff records (everyone in the business reads those):
      // they live in staffSecrets, which only the server (posAuth) reads. Old records may still carry
      // them until moved; a client may keep or remove them, never add or change them.
      function secretUnchanged(k) { return !(k in request.resource.data) || (resource != null && k in resource.data && request.resource.data[k] == resource.data[k]); }
      function noNewSecrets() { return secretUnchanged('pinHash') && secretUnchanged('pinSalt') && secretUnchanged('cardId'); }
      match /staff/{id} {
        allow read: if isMember(t);
        allow create: if isManager(t) && idMatches(id) && noNewSecrets();
        allow delete: if isManager(t);
        // POS terminals record sign-in control only: unlock, last sign-in, clock state (wrong PINs are counted by the server).
        allow update: if (isManager(t) && idMatches(id) && noNewSecrets()) || (canPos(t) && onlyChanges(['failedSignIns', 'lockedAt', 'lastSignInAt', 'clockedInAt']));
      }
      match /staffSecrets/{id} {
        allow read: if false;
        allow create, update: if isManager(t) && idMatches(id)
                              && request.resource.data.keys().hasOnly(['id', 'pinHash', 'pinSalt', 'cardId', 'pinChangedAt', 'updatedBy', 'updatedAt']);
        allow delete: if isManager(t);
      }
      // Photos and scans of paper bills (evidence). The file is stored in parts and fingerprinted;
      // it can't be changed, only its description and link. Terminals don't see them.
      function canFile() { return hasRole(t, ['owner', 'admin', 'manager', 'accountant', 'storekeeper']); }
      match /attachments/{id} {
        allow read: if canFile() || canAudit(t);
        allow create: if canFile() && request.resource.data.id == id && request.resource.data.uploadedBy == request.auth.uid
                      && request.resource.data.size is int && request.resource.data.size <= 10485760
                      && request.resource.data.sha256 is string && request.resource.data.chunks is int;
        allow update: if canFile() && onlyChanges(['linkedTo', 'status', 'documentDate', 'supplierName', 'amount', 'note']);
        allow delete: if isAdmin(t) && resource.data.status == 'inbox';
      }
      match /attachmentChunks/{id} {
        allow read: if canFile() || canAudit(t);
        allow create: if canFile() && request.resource.data.attachmentId is string
                      && request.resource.data.data is string && request.resource.data.data.size() <= 700000;
        allow update: if false;
        allow delete: if isAdmin(t);
      }
      // Each device reports its app version and last contact (System status page; release management).
      match /deviceStatus/{id} {
        allow read: if isMember(t);
        allow write: if isMember(t) && request.resource.data.id == id && request.resource.data.uid == request.auth.uid
                     && request.resource.data.size() <= 20;
      }
      // Errors seen in the app, for support. Append-only, small.
      match /clientErrors/{id} {
        allow read: if isManager(t) || canAudit(t);
        allow create: if isMember(t) && request.resource.data.uid == request.auth.uid
                      && request.resource.data.message is string && request.resource.data.message.size() <= 2000
                      && request.resource.data.get('stack', '').size() <= 8000;
        allow update: if false;
        allow delete: if isAdmin(t);
      }
      // POS transaction journal: append-only and hash-chained per workstation.
      match /posJournal/{id} {
        allow read: if canPos(t) || canAudit(t) || canSeeBooks(t);
        allow create: if canPos(t) && request.resource.data.id == id && request.resource.data.workstationId is string && request.resource.data.hash is string;
        allow update, delete: if false;
      }
      match /timeCards/{id} {
        allow read: if isMember(t);
        allow create: if canPos(t) && request.resource.data.id == id;
        allow update: if canPos(t) && !('clockOut' in resource.data);
        allow delete: if false;
      }
      match /menuImages/{id} { allow read: if isMember(t); allow write: if isManager(t) && idMatches(id); }
      match /budgets/{id} { allow read: if isMember(t); allow write: if isManager(t) && idMatches(id); }
      match /menuItems/{id} {
        allow read: if isMember(t);
        // Terminals may only mark items out of stock (86) or back on sale.
        allow create, delete: if isManager(t);
        allow update: if isManager(t) || (canPos(t) && onlyChanges(['available'])) || (canStock(t) && onlyChanges(['cost']));
      }

      // ── Selling ──
      match /checks/{id} {
        allow read: if isMember(t);
        allow create: if canPos(t) && idMatches(id);
        // Open checks change freely; a closed check only gets its stock-deduction flag updated.
        allow update: if (canPos(t) && resource.data.status == 'open')
                      || ((canPos(t) || canStock(t)) && onlyChanges(['depletion']));
        allow delete: if false;
      }
      match /invoices/{id} {
        allow read: if isMember(t);
        allow create: if canPos(t) && request.resource.data.id == id;
        allow update, delete: if false;
      }
      match /sequences/{id} { allow read: if isMember(t); allow write: if canPos(t); }
      match /dailyStats/{id} { allow read: if isMember(t); allow write: if canPos(t); }
      match /printJobs/{id} {
        allow read: if isMember(t);
        allow create: if isMember(t) && request.resource.data.status == 'queued';
        allow update: if isMember(t) && onlyChanges(['status', 'error', 'printedAt', 'agentId']);
        allow delete: if isManager(t);
      }
      match /messageLog/{id} { allow read: if isManager(t) || canBooks(t); allow create: if isMember(t); allow update, delete: if false; }
      match /audit/{id} { allow read: if isManager(t); allow create: if isMember(t); allow update, delete: if false; }

      // ── Customers (CRM module) ──
      match /customers/{id} {
        allow read: if isMember(t);
        // Guest profiles (CRM), and credit customers for receivables (accounting).
        allow write: if (moduleOn(t, 'crm') && (isManager(t) || canPos(t))) || (moduleOn(t, 'accounting') && canBooks(t));
      }

      // ── Inventory & purchasing (ERP modules) ──
      match /inventoryItems/{id} { allow read: if isMember(t); allow write: if (moduleOn(t, 'inventory') || moduleOn(t, 'recipes')) && canStock(t) && idMatches(id); }
      match /recipes/{id} { allow read: if isMember(t); allow write: if moduleOn(t, 'recipes') && canStock(t) && idMatches(id); }
      match /locations/{id} { allow read: if isMember(t); allow write: if moduleOn(t, 'inventory') && isManager(t); }
      // Suppliers are kept by purchasing staff, and by accountants for payables (accounting-only businesses).
      match /vendors/{id} { allow read: if isMember(t); allow write: if (moduleOn(t, 'purchasing') && canStock(t)) || (moduleOn(t, 'accounting') && canBooks(t)); }
      match /purchaseOrders/{id} { allow read: if isMember(t); allow write: if moduleOn(t, 'purchasing') && canStock(t); }
      match /goodsReceipts/{id} {
        allow read: if isMember(t);
        allow create: if moduleOn(t, 'purchasing') && canStock(t);
        allow update: if moduleOn(t, 'purchasing') && canStock(t) && resource.data.status != 'posted';
        allow delete: if moduleOn(t, 'purchasing') && canStock(t) && resource.data.status != 'posted';
      }
      match /stockLevels/{id} { allow read: if isMember(t); allow write: if moduleOn(t, 'inventory') && (canStock(t) || canPos(t)); }
      match /stockMovements/{id} {
        allow read: if isMember(t);
        allow create: if moduleOn(t, 'inventory') && (canStock(t) || canPos(t));
        allow update, delete: if false;
      }
      match /stockCounts/{id} { allow read: if isMember(t); allow write: if moduleOn(t, 'inventory') && canStock(t); }

      // ── Accounting module (ERPNext-style ledger; postings only by Cloud Functions) ──
      match /accounts/{id} { allow read: if isMember(t); allow create, update: if moduleOn(t, 'accounting') && canBooks(t) && idMatches(id); allow delete: if false; }
      match /vouchers/{id} {
        allow read: if canSeeBooks(t);
        // Drafts belong to their preparer; submitting, approving and posting happen on the server.
        allow create: if moduleOn(t, 'accounting') && canBooks(t) && idMatches(id)
                      && request.resource.data.status == 'draft' && request.resource.data.createdBy == request.auth.uid
                      && !('number' in request.resource.data) && !('hash' in request.resource.data);
        allow update: if canBooks(t) && resource.data.status == 'draft' && resource.data.createdBy == request.auth.uid
                      && request.resource.data.status == 'draft' && request.resource.data.createdBy == request.auth.uid
                      && !('number' in request.resource.data) && !('hash' in request.resource.data);
        allow delete: if canBooks(t) && resource.data.status == 'draft' && resource.data.createdBy == request.auth.uid;
      }
      match /ledger/{id} { allow read: if canSeeBooks(t); allow write: if false; }
      match /accountBalances/{id} { allow read: if canSeeBooks(t); allow write: if false; }
      match /numberSeries/{id} { allow read: if canSeeBooks(t); allow write: if false; }
      match /ledgerHead/{id} { allow read: if canSeeBooks(t); allow write: if false; }
      match /fiscalYears/{id} { allow read: if isMember(t); allow write: if false; }
      match /costCenters/{id} { allow read: if isMember(t); allow create, update: if moduleOn(t, 'accounting') && canBooks(t) && idMatches(id); allow delete: if false; }
      match /glBudgets/{id} { allow read: if canSeeBooks(t); allow write: if moduleOn(t, 'accounting') && canBooks(t) && idMatches(id); }
      match /exchangeRates/{id} { allow read: if isMember(t); allow write: if moduleOn(t, 'accounting') && canBooks(t) && idMatches(id); }
      match /bankStatements/{id} { allow read: if canSeeBooks(t); allow create: if moduleOn(t, 'accounting') && canBooks(t) && request.resource.data.importedBy == request.auth.uid; allow update, delete: if false; }
      match /bankRecons/{id} {
        allow read: if canSeeBooks(t);
        allow create: if moduleOn(t, 'accounting') && canBooks(t) && request.resource.data.createdBy == request.auth.uid;
        allow delete: if canBooks(t);
        allow update: if false;
      }
      match /assets/{id} {
        allow read: if canSeeBooks(t);
        allow create: if moduleOn(t, 'accounting') && canBooks(t) && idMatches(id) && request.resource.data.status == 'active';
        // Depreciation and disposal figures are maintained by the server only.
        allow update: if moduleOn(t, 'accounting') && canBooks(t)
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accumulatedDep', 'lastDepPeriod', 'status', 'disposalDate']);
        allow delete: if canBooks(t) && resource.data.accumulatedDep == 0 && !('lastDepPeriod' in resource.data);
      }
      match /journals/{id} {
        allow read: if canBooks(t) || isManager(t);
        allow create, update: if moduleOn(t, 'accounting') && (canBooks(t) || canPos(t));
        allow delete: if moduleOn(t, 'accounting') && canBooks(t);
      }

      // Anything not listed above is closed.
      match /{other=**} {
        allow read, write: if false;
      }
    }
  }
}
