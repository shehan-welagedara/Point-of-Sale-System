{
  "name": "point-of-sale-system",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pos/web dev",
    "build": "pnpm --filter @pos/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pos-suite \"vitest run --root firebase\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-pos-suite",
    "templates": "pnpm --filter @pos/excel templates",
    "agent": "pnpm --filter @pos/print-agent start",
    "firebase:deploy": "pnpm build && firebase deploy --only hosting,firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.10.0",
    "firebase-tools": "14.27.0",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "re2"
    ]
  }
}
