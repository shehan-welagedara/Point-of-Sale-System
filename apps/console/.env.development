# `pnpm console:dev` runs the console against its emulators (`pnpm console:emulators` in another
# terminal). Not used by builds for deployment: on Firebase Hosting the console reads its project's
# settings at start-up.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_PROJECT_ID=demo-polymath-console
VITE_FIREBASE_AUTH_DOMAIN=demo-polymath-console.firebaseapp.com
VITE_FIREBASE_APP_ID=1:1:web:1
